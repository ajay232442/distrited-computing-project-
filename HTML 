            nodes: [
                { id: 'gateway', label: 'API Gateway', x: 0.15, y: 0.5, color: '#22d3ee', icon: '\uf516' },
                { id: 'broker', label: 'Task Broker Queue', x: 0.45, y: 0.5, color: '#818cf8', icon: '\uf233' },
                { id: 'worker1', label: 'Worker Node 01', x: 0.75, y: 0.25, color: '#10b981', active: true, icon: '\uf109' },
                { id: 'worker2', label: 'Worker Node 02', x: 0.75, y: 0.75, color: '#10b981', active: true, icon: '\uf109' },
                { id: 'storage', label: 'Consensus DB / Storage', x: 0.9, y: 0.5, color: '#c084fc', icon: '\uf1c0' }
            ]
        };

        const canvas = document.getElementById('topologyCanvas');
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        // Spawn interactive packet animation
        function spawnPacket(fromId, toId, color = '#22d3ee') {
            const fromNode = state.nodes.find(n => n.id === fromId);
            const toNode = state.nodes.find(n => n.id === toId);
            if (!fromNode || !toNode) return;

            state.packets.push({
                x: fromNode.x,
                y: fromNode.y,
                targetX: toNode.x,
                targetY: toNode.y,
                progress: 0,
                speed: 0.01 + Math.random() * 0.015,
                color: color
            });
        }

        // Main Animation Loop
        function animate() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            const w = canvas.width;
            const h = canvas.height;

            // Draw Connections
            const connections = [
                ['gateway', 'broker'],
                ['broker', 'worker1'],
                ['broker', 'worker2'],
                ['worker1', 'storage'],
                ['worker2', 'storage']
            ];

            connections.forEach(([fromId, toId]) => {
                const from = state.nodes.find(n => n.id === fromId);
                const to = state.nodes.find(n => n.id === toId);

                const isBlocked = state.partitioned && (fromId === 'broker' || toId === 'broker');

                ctx.beginPath();
                ctx.moveTo(from.x * w, from.y * h);
                ctx.lineTo(to.x * w, to.y * h);
                ctx.strokeStyle = isBlocked ? 'rgba(244, 63, 94, 0.4)' : 'rgba(255, 255, 255, 0.08)';
                ctx.lineWidth = isBlocked ? 3 : 2;
                if (isBlocked) ctx.setLineDash([6, 6]);
                else ctx.setLineDash([]);
                ctx.stroke();
                ctx.setLineDash([]);
            });

            // Randomly Spawn Data Stream Packets
            if (state.running && Math.random() < 0.3) {
                spawnPacket('gateway', 'broker', '#22d3ee');
            }
            if (state.running && Math.random() < 0.25) {
                if (!state.workerFailed) spawnPacket('broker', 'worker1', '#818cf8');
                spawnPacket('broker', 'worker2', '#818cf8');
            }
            if (state.running && Math.random() < 0.2) {
                if (!state.workerFailed) spawnPacket('worker1', 'storage', '#10b981');
                spawnPacket('worker2', 'storage', '#10b981');
            }

            // Update & Render Packets
            for (let i = state.packets.length - 1; i >= 0; i--) {
                const p = state.packets[i];
                if (state.running) p.progress += p.speed;

                if (p.progress >= 1) {
                    state.packets.splice(i, 1);
                    continue;
                }

                const currentX = (p.x + (p.targetX - p.x) * p.progress) * w;
                const currentY = (p.y + (p.targetY - p.y) * p.progress) * h;

                ctx.beginPath();
                ctx.arc(currentX, currentY, 4, 0, Math.PI * 2);
                ctx.fillStyle = p.color;
                ctx.shadowColor = p.color;
                ctx.shadowBlur = 10;
                ctx.fill();
                ctx.shadowBlur = 0;
            }

            // Draw Nodes
            state.nodes.forEach(node => {
                const nx = node.x * w;
                const ny = node.y * h;

                const isDead = node.id === 'worker1' && state.workerFailed;

                // Outer Node Halo
                ctx.beginPath();
                ctx.arc(nx, ny, 24, 0, Math.PI * 2);
                ctx.fillStyle = isDead ? 'rgba(244, 63, 94, 0.15)' : 'rgba(18, 26, 45, 0.8)';
                ctx.strokeStyle = isDead ? '#f43f5e' : node.color;
                ctx.lineWidth = 2;
                ctx.fill();
                ctx.stroke();

                // Inner Glow/Point
                ctx.beginPath();
                ctx.arc(nx, ny, 6, 0, Math.PI * 2);
                ctx.fillStyle = isDead ? '#f43f5e' : node.color;
                ctx.fill();

                // Node Label
                ctx.font = '11px "JetBrains Mono", monospace';
                ctx.fillStyle = isDead ? '#f43f5e' : '#cbd5e1';
                ctx.textAlign = 'center';
                ctx.fillText(isDead ? `${node.label} (CRASHED)` : node.label, nx, ny + 40);
            });

            requestAnimationFrame(animate);
        }

        animate();

        // Control Functions
        function toggleSimulation() {
            state.running = !state.running;
            document.getElementById('sim-text').innerText = state.running ? 'Pause Simulation' : 'Resume Simulation';
            document.getElementById('sim-icon').className = state.running ? 'fa-solid fa-pause' : 'fa-solid fa-play';
        }

        function injectPayload() {
            for (let i = 0; i < 20; i++) {
                setTimeout(() => {
                    spawnPacket('gateway', 'broker', '#22d3ee');
                    if (Math.random() > 0.3) spawnPacket('broker', 'worker2', '#818cf8');
                }, i * 50);
            }
        }

        function toggleWorkerFailure() {
            state.workerFailed = !state.workerFailed;
            const btn = document.getElementById('btn-kill-worker');
            const statWorkers = document.getElementById('stat-workers');

            if (state.workerFailed) {
                btn.classList.replace('bg-rose-500/20', 'bg-emerald-500/20');
                btn.classList.replace('text-rose-300', 'text-emerald-300');
                btn.innerHTML = '<i class="fa-solid fa-[#10b981] fa-heart-pulse"></i> Recover Worker Node';
                statWorkers.innerText = '3 / 4 Online (Degraded)';
                statWorkers.className = 'text-rose-400 font-bold ml-1';
            } else {
                btn.classList.replace('bg-emerald-500/20', 'bg-rose-500/20');
                btn.classList.replace('text-emerald-300', 'text-rose-300');
                btn.innerHTML = '<i class="fa-solid fa-skull"></i> Simulate Worker Failure';
                statWorkers.innerText = '4 / 4 Online';
                statWorkers.className = 'text-emerald-400 font-bold ml-1';
            }
        }

        function triggerPartition() {
            state.partitioned = !state.partitioned;
            const btn = document.getElementById('btn-partition');
            const statConsensus = document.getElementById('stat-consensus');

            if (state.partitioned) {
                btn.classList.replace('bg-amber-500/20', 'bg-brand-500/20');
                btn.classList.replace('text-amber-300', 'text-brand-300');
                btn.innerHTML = '<i class="fa-solid fa-link"></i> Heal Network Partition';
                statConsensus.innerText = 'Fenced (Split-Brain Blocked)';
                statConsensus.className = 'text-amber-400 font-bold ml-1';
            } else {
                btn.classList.replace('bg-brand-500/20', 'bg-amber-500/20');
                btn.classList.replace('text-brand-300', 'text-amber-300');
                btn.innerHTML = '<i class="fa-solid fa-network-wired"></i> Trigger Network Partition';
                statConsensus.innerText = 'RAFT Quorum Active';
                statConsensus.className = 'text-brand-400 font-bold ml-1';
            }
        }
    </script>
</body>
</html>
